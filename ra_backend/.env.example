# RADONAIX Revenue Assurance backend — configuration template.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is not, so it must
# never hold a real secret or password.
#
# Only the settings a deployment normally changes are listed. Every other
# setting has a code default in app/core/config.py and can be added here by
# upper-casing its field name (e.g. `pipeline_default_hours` -> PIPELINE_DEFAULT_HOURS).

# --- General -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Human-readable console logs. Set true for JSON (what a log shipper wants).
LOG_JSON=false
# Origins allowed to call this API from a browser, comma-separated. The Vite dev
# server is 5173 by default; 8080 is the Lovable preview.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081

# --- Auth --------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-48-char-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@radonaix.io
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
# Password given to the seeded non-admin demo users.
DEMO_PASSWORD=ChangeMe!123

# --- App database (owned: users, roles, cases, reports, audit, exports) ------
# This is the ONLY database the app owns. Everything else is read-only.
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=radonaix_app
APP_DB_USER=radonaix
APP_DB_PASSWORD=radonaix
APP_DB_SCHEMA=administration

# --- Redis / Celery (bulk exports only) --------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# false -> every /exports route returns 503 and no Redis or worker is needed.
EXPORTS_ENABLED=true
# Hand large downloads to nginx via X-Accel-Redirect. Off without a reverse proxy.
EXPORT_XACCEL_ENABLED=false

# --- ra-platform Postgres (read-only sources + authored rules) ---------------
# Supplies the Rule Explorer's table/column metadata and the pipeline file logs.
# Turn off and those screens degrade rather than fail.
RA_PG_ENABLED=true
RA_PG_HOST=10.200.36.69
RA_PG_PORT=5432
RA_PG_NAME=rafms
RA_RATING_PG_NAME=rafms_rating
RA_PG_USER=postgres
RA_PG_PASSWORD=postgres
# The one database on this host the app writes to: authored assurance rules.
APP_RULES_DB_NAME=rafms_rating
APP_RULES_SCHEMA=application_schema

# --- Reconciliation rule engine ----------------------------------------------
# Generated reconciliation tables land here, in the source tables' own database.
RECON_OUTPUT_SCHEMA=assurance
# The scheduler runs due rules on a timer and WRITES to the database above.
# Leave false on a workstation pointed at a shared server.
RECON_SCHEDULER_ENABLED=false
# Where a breached run posts its case. The API BASE — the /api prefix is
# required, since the engine appends /cases/ingest to it.
CASES_API_BASE=http://127.0.0.1:8001/api

# --- Optional integrations ---------------------------------------------------
# ClickHouse backs the recon summaries and dashboard KPIs. Off -> placeholders.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=rafms

# Airflow REST, used by pipeline retry/replay.
AIRFLOW_ENABLED=false

# Prometheus backs the monitoring screens.
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=http://127.0.0.1:9090

# Embedded Superset dashboard (guest-token flow).
SUPERSET_ENABLED=false

# SSO. Off -> username/password only.
SSO_ENABLED=false

# SMTP. Off -> the mailer LOGS each message at INFO, so password reset still
# works locally: the reset link appears in the server console.
SMTP_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173

# --- Reporting ---------------------------------------------------------------
# Must be writable by the process. The packaged default (/var/lib/radonaix/reports)
# suits a server, not a workstation.
REPORTS_DIR=./var/reports
