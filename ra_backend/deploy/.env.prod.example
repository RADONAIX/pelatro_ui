# =====================================================================
# RADONAIX backend — PRODUCTION .env template
# Copy to `.env` on the VM and fill in real values. NEVER commit the real .env.
# Used by BOTH deploy tracks (Docker Compose and bare-VM/systemd).
# =====================================================================

# --- General ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_PREFIX=/api
# The browser origin(s) of the UI. NO "*" in production.
CORS_ORIGINS=http://10.200.36.156:3000

# --- Auth / JWT ---
# REQUIRED in production — the app REFUSES TO START otherwise:
#   * JWT_SECRET must be a unique random value, >= 32 chars (not the default).
#     generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   * BOOTSTRAP_ADMIN_PASSWORD must be changed from the default.
JWT_SECRET=jhr9opd8JdqYt7dPIoyqHbDQ2bfGKQLwydKGFYtYT7LwfrzQKGMS1cqh5n7X8Qzc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=manojbm@platum-ai.co.in
BOOTSTRAP_ADMIN_PASSWORD=Platum@9999
DEMO_PASSWORD=

# --- Email / SMTP (forgot / reset password) ---
# SMTP_ENABLED=false → the reset LINK is written to the app log instead of being
# emailed (fine for testing). Set true + fill creds to actually send. The Grafana
# Gmail app password can be reused here (SMTP_HOST=smtp.gmail.com, PORT=587).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@radonaix.io
SMTP_STARTTLS=true
# SPA origin used to build the reset link: {FRONTEND_BASE_URL}/reset-password?token=...
FRONTEND_BASE_URL=https://10.200.36.156
RESET_TOKEN_TTL_MINUTES=30

# --- App database (the app's OWN data: users/roles/audit/exports) ---
# Fleet deployment: the application Postgres lives on the reporting server (142),
# alongside the API. (Monitored as the "rpt-master" Postgres target.)
# NOTE: this DB must hold the `administration` schema — run `alembic upgrade head`
# (+ seed the admin user) against it before pointing here, or the app has no users.
# Docker track instead: APP_DB_HOST=postgres (bundled compose service).
APP_DB_HOST=10.200.37.142
APP_DB_PORT=5432
APP_DB_NAME=radonaix_app
APP_DB_USER=radonaix
APP_DB_PASSWORD=postgres
APP_DB_SCHEMA=administration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Bulk exports (Download Center: async, filtered report CSV exports) ---
# true = the /exports API + Download Center are live. REQUIRES: Redis running +
# the Celery worker (systemctl enable --now radonaix-worker) + REPORTS_DIR
# writable by BOTH the api and worker users. Set false to disable (all /exports
# routes return 503; no Redis/worker needed).
EXPORTS_ENABLED=true

# --- Redis + Celery (needed when EXPORTS_ENABLED=true) ---
# Docker track: redis://redis:6379/... (set in compose). Bare VM: localhost.
# Install Redis on the app host: `dnf install redis && systemctl enable --now redis`.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Bulk exports ---
# How long a finished export stays downloadable before it expires + is purged
# (the UI says "available for 48 hours"). Keep them in sync.
EXPORT_RETENTION_HOURS=48
EXPORT_MAX_CONCURRENT_PER_USER=3
EXPORT_MAX_DATE_SPAN_DAYS=31
EXPORT_CHUNK_ROWS=50000
# Where export .csv.gz files are written (must be writable; shared API<->worker).
REPORTS_DIR=/var/lib/radonaix/reports

# --- Bulk exports: scale hardening (billion-row jobs) ---
# gzip 1 ≈ half the CPU/wall-clock of 9 for ~30-50% larger files (fine on 2 TB).
EXPORT_GZIP_LEVEL=1
# CRITICAL: Redis re-delivers an un-acked task after this window. Both time limits
# below MUST stay under it or a task that outlives it runs twice. 12 h default.
EXPORT_VISIBILITY_TIMEOUT_SECONDS=43200
EXPORT_JOB_SOFT_LIMIT_SECONDS=39600    # single-file + finalize task limit (11 h; hard = +5 min)
EXPORT_PART_SOFT_LIMIT_SECONDS=21600   # per fan-out part limit (6 h; hard = +5 min)
EXPORT_COUNT_TIMEOUT_SECONDS=15        # PG exact-count timeout → else indeterminate progress
EXPORT_PROGRESS_COMMIT_SECONDS=2       # throttle progress writes
# Multi-part parallel exports. The trigger is estimated ROWS (≈ duration), NOT
# calendar span — so a wide, no-date-range export still fans out. A sizing pass
# (count + per-day histogram, timeout-guarded) plans date-bounded parts run
# concurrently, then assembled into one .csv.gz.
EXPORT_MULTIPART_ROW_THRESHOLD=2000000     # est. rows > this → fan out into parts
EXPORT_TARGET_PART_ROWS=5000000            # aim for ~this many rows per part
EXPORT_DAYS_PER_PART=7                      # max calendar days packed into one part
EXPORT_HISTOGRAM_TIMEOUT_SECONDS=20        # per-day density sizing pass (guarded)
EXPORT_SINGLE_FILE_HARD_MAX_ROWS=50000000  # no-date-column report bigger than this → reject
EXPORT_SOFT_MAX_PARTS=60                    # warn above this many parts
EXPORT_HARD_MAX_PARTS=200                   # reject above this many parts
# Resilience: a transient blip in ONE part retries (only that part re-runs — the
# already-completed siblings are kept) instead of losing the whole job. Finalize
# (the concat) retries too. Only after exhausting retries does the job fail.
EXPORT_PART_MAX_RETRIES=2
EXPORT_PART_RETRY_COUNTDOWN=60             # seconds between part retries
EXPORT_FINALIZE_MAX_RETRIES=2
EXPORT_FINALIZE_RETRY_COUNTDOWN=30
# Excel-friendly output: the artifact is a .zip of CSV files, each with this many
# rows max (opens in Excel — limit is 1,048,576). Set 0 for a single .csv.gz.
EXPORT_CSV_SPLIT_ROWS=1000000
# Disk safety: refuse a new export up front unless the volume can hold its
# estimated on-disk peak PLUS the free floor, and unless total live-artifact
# storage is under the cap. BYTES_PER_ROW_ESTIMATE = uncompressed CSV bytes/row
# (the guard applies the gzip ratio + the multipart parts+concat peak internally).
EXPORT_BYTES_PER_ROW_ESTIMATE=200
EXPORT_MIN_FREE_BYTES=21474836480      # 20 GB free floor (kept after the export)
EXPORT_MAX_TOTAL_STORAGE_GB=800        # of the 2 TB volume
# Hand large downloads to nginx (native Range/resume + sendfile) via
# X-Accel-Redirect. Requires the internal /_export_files/ location in nginx
# (deploy/nginx/radonaix.conf) with alias = REPORTS_DIR, readable by nginx.
# Set false on deployments without that nginx location (FastAPI streams instead).
EXPORT_XACCEL_ENABLED=true
EXPORT_XACCEL_LOCATION=/_export_files

# --- ra-platform read-only sources (ALWAYS external — never containerized) ---
CLICKHOUSE_ENABLED=true
CLICKHOUSE_HOST=10.200.36.69
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=rafms
# Per-query safety limits (applied to EVERY ClickHouse read) so a heavy sort spills
# to disk / errors cleanly instead of OOMing the shared server. 0 = server default.
CLICKHOUSE_MAX_BYTES_BEFORE_EXTERNAL_SORT=8589934592   # 8 GiB → spill beyond this
CLICKHOUSE_MAX_MEMORY_USAGE=0                          # 0 = server default; set to cap per query
CLICKHOUSE_MAX_EXECUTION_TIME=300                      # seconds; 0 = no cap

# Pipeline batch/file logs (rafms_app) + BI report matviews (rafms/bi_reports).
# SHARED / FALLBACK connection: used for any stream WITHOUT a STREAM_*_PG_* override
# below, and by the Pipeline Map / Job Monitor screens. In split-DB mode point it at
# whichever stream server the Job Monitor should read (see the split note below).
RA_PG_ENABLED=true
RA_PG_HOST=10.200.37.142
RA_PG_PORT=5432
RA_PG_NAME=rafms
RA_PG_USER=postgres
RA_PG_PASSWORD=postgres
RA_BI_PG_NAME=rafms
RA_BI_PG_SCHEMA=bi_reports

# --- Data streams (plug-and-play data sources) ---
# Enabled streams, comma-separated. Adding a CONVENTIONAL new source (same DBs,
# {key}_schema + {key}_* tables) is just adding its key here — the Pipeline Map
# and every report pick it up with NO code change. e.g. air,sdp,msc or air,sdp,ccn.
DATA_STREAMS=air,sdp
# Optional YAML overriding convention for a source with an odd schema / non-standard
# tables (see deploy/data_sources.example.yaml). Empty = convention only.
DATA_SOURCES_FILE=

# --- Split-DB mode: per-stream Postgres on separate servers ---
# Each stream's Postgres on its OWN server: AIR on 133, SDP on 142. STREAM_{KEY}_PG_HOST
# activates the override; every other field falls back to the shared RA_PG_* above, so
# host + password is enough. Reports/exports query each server and merge (no code change).
# To go back to consolidated (one Postgres), comment this whole block out.
#
# NOTE: this covers Reports + the Download Center exports. The Pipeline Map / Job
# Monitor live screens still read the SHARED RA_PG_HOST only — set that to the stream
# whose Job Monitor you need, until those screens are made split-aware too.
# STREAM_AIR_PG_HOST=10.200.37.133
# STREAM_AIR_PG_PORT=5432
# STREAM_AIR_PG_NAME=rafms            # pipeline-logs DB (default = RA_PG_NAME)
# STREAM_AIR_PG_BI_NAME=rafms         # BI-reports DB    (default = RA_BI_PG_NAME)
# STREAM_AIR_PG_USER=postgres
# STREAM_AIR_PG_PASSWORD=postgres
# STREAM_SDP_PG_HOST=10.200.37.142
# STREAM_SDP_PG_PORT=5432
# STREAM_SDP_PG_NAME=rafms
# STREAM_SDP_PG_BI_NAME=rafms
# STREAM_SDP_PG_USER=postgres
# STREAM_SDP_PG_PASSWORD=postgres

# --- Airflow (pipeline control) — optional ---
AIRFLOW_ENABLED=false

SUPERSET_ENABLED=true
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin123