# Copy to `.env` for local development (`.env` is gitignored; `.env.production`
# holds the deployed values). Every variable here is optional — the code default
# is shown alongside.

# Case management API (Pelatro_Backend). Must match PORT in
# Pelatro_Backend/.env — that is the only other place the port is set.
# Use 127.0.0.1 rather than localhost: localhost resolves to ::1 first on a
# dual-stack machine while uvicorn binds IPv4, and the browser's first
# connection attempt is then refused.
VITE_CASES_API_BASE=http://127.0.0.1:8001

# RADONaix platform API — ra_backend (reports, pipelines, users, auth, and the
# Controls module's table metadata + authored rules). MUST end in /api: the
# clients send bare paths like "/metadata/tables", and login derives the origin
# by stripping this suffix. Unset means "/api", i.e. same-origin behind nginx.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# VITE_PIPELINES_API_BASE=http://localhost:8000
# Only for a deployment that serves auth from a DIFFERENT host than the API
# above; otherwise leave unset so login follows VITE_API_BASE_URL.
# VITE_AUTH_API_BASE=http://localhost:8000

# Rating Assurance API — ra_rating_backend, a SEPARATE service on port 8010 that
# mounts itself at /api/rating. Unset means the relative "/api/rating", which is
# right behind nginx (it longest-prefix matches ahead of /api/) and wrong in dev,
# where it resolves against the Vite server instead. It verifies the token
# ra_backend issues, so the two services need the SAME JWT_SECRET.
VITE_RATING_API_BASE_URL=http://127.0.0.1:8010/api/rating

# VITE_SUPERSET_DOMAIN=

# System Monitoring's embedded Grafana. Unset means "/grafana" — same origin,
# which is how the deployed nginx serves it. In dev the SPA is on a different
# origin and that nginx adds `X-Frame-Options: SAMEORIGIN`, so the iframe is
# refused; point this at Grafana's OWN port instead, which sets no such header.
# Keep the /grafana suffix — Grafana's root_url includes it.
VITE_GRAFANA_URL=http://10.200.37.142:3000/grafana

# The ServerOps console. It sends `X-Frame-Options: DENY` and so cannot be
# embedded by anything, same origin included — System Monitoring links out to it
# rather than framing it. Unset means "/serverops/" on this app's own origin.
VITE_SERVEROPS_URL=https://10.200.37.142/serverops/
