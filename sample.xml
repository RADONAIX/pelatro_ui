<?xml version="1.0" encoding="UTF-8"?>
<RuleImport version="1.0" operator="DemoTel" sourceSystem="XML_IMPORT">

    <!-- ====================================================== -->
    <!-- Rule 1 : Prepaid Local Voice -->
    <!-- ====================================================== -->
    <Rule>
        <RuleId>R001</RuleId>
        <RuleName>Prepaid Local Voice Peak</RuleName>
        <ChargingMode>PREPAID</ChargingMode>
        <RuleType>BASE_TARIFF</RuleType>
        <Service>VOICE</Service>

        <Product>PREPAID_A</Product>
        <Offer>STANDARD</Offer>
        <TariffPlan>PP_VOICE_PLAN</TariffPlan>

        <Conditions>
            <Condition field="destination_zone" operator="EQUALS">LOCAL_ONNET</Condition>
            <Condition field="time_band" operator="EQUALS">PEAK</Condition>
        </Conditions>

        <Actions>
            <Action type="SET_RATE">
                <Value>0.10</Value>
                <Currency>GBP</Currency>
                <Unit>MINUTE</Unit>
            </Action>
        </Actions>

        <Priority>100</Priority>

        <EffectiveFrom>2026-08-01</EffectiveFrom>
        <EffectiveTo>2027-12-31</EffectiveTo>

    </Rule>

