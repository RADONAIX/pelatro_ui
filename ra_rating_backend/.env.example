# RADONaix Rating Assurance service — copy to .env and adjust.
#
# CRITICAL: JWT_SECRET and JWT_ALGORITHM must be IDENTICAL to ra_backend/.env.
# This service verifies the access tokens that service issues; a mismatch makes
# every authenticated request return 401 with no other symptom.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/rating
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Auth (verify only — this service never issues a token) -----------------
JWT_SECRET=dev-only-change-me-to-a-48char-random-secret-000000000000
JWT_ALGORITHM=HS256

# --- Rating database (schema `rating`, read/write, owned by this service) ---
RATING_DB_HOST=localhost
RATING_DB_PORT=5432
RATING_DB_NAME=radonaix_app
RATING_DB_USER=radonaix
RATING_DB_PASSWORD=radonaix
RATING_DB_SCHEMA=rating
RATING_DB_POOL_SIZE=5
RATING_DB_MAX_OVERFLOW=5
RATING_DB_ECHO=false

# --- Identity bridge (schema `administration`, READ-ONLY) -------------------
# Point this at the same database ra_backend uses. Grant the user SELECT only
# on administration.users and administration.user_sessions — the connection is
# also opened read-only, so writes are impossible either way.
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=radonaix_app
IDENTITY_DB_USER=radonaix
IDENTITY_DB_PASSWORD=radonaix
IDENTITY_DB_SCHEMA=administration
IDENTITY_CACHE_SECONDS=30

# --- ClickHouse (execution plane — Phase 2+; a NEW database, never `rafms`) -
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=rating_assurance

# --- Airflow (execution plane — Phase 3+) ----------------------------------
AIRFLOW_ENABLED=false
AIRFLOW_BASE_URL=http://localhost:8081/api/v1
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# --- Rule engine limits ----------------------------------------------------
MAX_CONDITIONS_PER_RULE=50
MAX_ACTIONS_PER_RULE=25
MAX_RULES_PER_RULE_SET=20000

# --- MSC CDR source (READ-ONLY) --------------------------------------------
# The raw switch records. Opened with default_transaction_read_only=on, so a
# write against the operator's CDR archive is rejected by Postgres itself.
# Disabled by default: leave it off and nothing about this deployment changes.
MSC_SOURCE_ENABLED=false
MSC_SOURCE_HOST=10.200.37.142
MSC_SOURCE_PORT=5432
MSC_SOURCE_NAME=rafms_rating
MSC_SOURCE_USER=postgres
MSC_SOURCE_PASSWORD=postgres
MSC_SOURCE_SCHEMA=msc_schema
# Comma-separated — list sm_msc01..sm_msc08 here rather than changing code.
MSC_SOURCE_TABLES=sm_msc01
MSC_SOURCE_FETCH_SIZE=5000
# Numbers arrive TBCD-encoded in national, international and subscriber formats
# interchangeably. These normalise them to one form so longest-prefix matching
# sees a single representation.
MSC_HOME_COUNTRY_CODE=855
MSC_TRUNK_PREFIX=0
# The switch's own MCC+MNC. A different serving network means roaming.
MSC_HOME_MCCMNC=54F660

# --- OCS / IN actual-charge source (READ-ONLY) -----------------------------
# MSC CDRs carry NO charged amount — this is what a switch record is, not a gap
# in the loader. Without this source every result is NO_ACTUAL_CHARGE: the
# expected charge is still computed, but there is nothing to compare it against.
# Never inferred as zero, which would report every unbilled call as correct.
OCS_SOURCE_ENABLED=false
OCS_SOURCE_HOST=localhost
OCS_SOURCE_PORT=5432
OCS_SOURCE_NAME=rafms_rating
OCS_SOURCE_USER=postgres
OCS_SOURCE_PASSWORD=postgres
OCS_SOURCE_SCHEMA=ocs_schema
OCS_SOURCE_TABLE=ocs_charges
# Column names on that table, so a differently-shaped source is wired here
# rather than in code.
OCS_COLUMN_MSISDN=msisdn
OCS_COLUMN_CALLED_NUMBER=called_number
OCS_COLUMN_EVENT_TIME=event_start_time
OCS_COLUMN_DURATION=duration_seconds
OCS_COLUMN_CALL_REFERENCE=call_reference
OCS_COLUMN_CHARGE=charged_amount
OCS_COLUMN_CURRENCY=currency

# --- Rating assurance execution --------------------------------------------
RATING_BATCH_SIZE=5000
MAXIMUM_RECORDS_PER_RUN=1000000
# Either tolerance clearing marks a record MATCHED. Requiring both would
# suppress a real 40% variance on a small charge.
ABSOLUTE_VARIANCE_TOLERANCE=0.005
PERCENTAGE_VARIANCE_TOLERANCE=0.5
DEFAULT_CURRENCY_SCALE=2
DEFAULT_CURRENCY=GHS
# How far apart an MSC event and an OCS charge may be and still correlate.
ACTUAL_CHARGE_TIME_TOLERANCE_SECONDS=5
MAXIMUM_RETRY_COUNT=3

# --- Mirror: additive write-only sync into rafms_rating_new ------------------
# A SECOND database that receives a copy of the rule and metadata rows this
# service writes. Never read from. The mirror runs AFTER the primary transaction
# commits and swallows its own failures, so an unreachable mirror produces log
# warnings and nothing else.
#
# Off by default: with MIRROR_ENABLED=false no engine is opened and every hook
# returns on its first line, so the platform behaves exactly as it did before
# this feature existed.
MIRROR_ENABLED=false
MIRROR_DB_HOST=localhost
MIRROR_DB_PORT=5432
MIRROR_DB_NAME=rafms_rating_new
MIRROR_DB_USER=postgres
MIRROR_DB_PASSWORD=postgres
MIRROR_DB_SCHEMA=canonical_rating
MIRROR_DB_POOL_SIZE=3
MIRROR_DB_MAX_OVERFLOW=2
# subscriber_offer and subscriber_bundle_balance are fed by the rating engine,
# not by rule authoring, and both FK into canonical_rating.subscriber — a table
# this platform has no source for. Leave off unless that table is populated.
MIRROR_SUBSCRIBER_ENABLED=false
# Which rule store feeds the mirror: AUTO | LEGACY | CANONICAL | BOTH.
# Both models are live during the R4 cut-over and describe the same estate, so
# mirroring both puts each rule in the target twice under two rule_ids. AUTO
# follows RULE_COMPILE_SOURCE, i.e. whichever model actually prices traffic.
MIRROR_RULE_SOURCE=AUTO
